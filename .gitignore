.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ============ 临时 / 缓存 ============
tmp/
*.tmp
*.bak
*.local

# Downloaded CJK fonts (recreated by engine/get_fonts.py)
engine/fonts/NotoSerifSC-VF.ttf
engine/fonts/NotoSansSC-VF.ttf

# Generated outputs at any project nesting depth
**/renders/
**/audio/
**/review/

# Private local configuration and archives
.env.*
*.bundle
*.zip
