# ============ Python ============
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ============ Node ============
node_modules/
*.log

# ============ 渲染产物（不进入版本控制：mp4 重新跑一遍就有） ============
projects/*/renders/
projects/*/audio/
projects/*/review/
projects/*/make_voiceover.py
projects/*/make_bgm.py

# examples 里的渲染产物（按需保留代表性截图，不要全留）
examples/**/review/
examples/**/renders/
examples/**/audio/
examples/**/*.mp4
examples/**/*.wav
examples/**/*.tmp
examples/**/gen_blob.py

